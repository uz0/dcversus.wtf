{
  "name": "dcversus.wtf",
  "version": "1.0.0",
  "description": "DCVS - Professional consulting landing page with modern design",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node --loader ts-node/esm scripts/build.mts",
    "preview": "vite preview",
    "start": "npm run preview",
    "deploy": "npm run build && node --loader ts-node/esm scripts/deploy.mts",
    "type-check": "tsc --noEmit",
    "type-check:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "changelog": "node --loader ts-node/esm scripts/changelog.mts",
    "postbuild": "node --loader ts-node/esm scripts/postbuild.mts",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install",
    "test:e2e:report": "playwright show-report",
    "test:unit": "tsc --noEmit && npm run test:e2e",
    "test:ci": "npm run build && start-server-and-test preview http://localhost:4173 test:e2e"
  },
  "devDependencies": {
    "vite": "^5.4.10",
    "vite-plugin-live-reload": "^3.0.2",
    "@tailwindcss/vite": "^4.0.0-alpha.26",
    "tailwindcss": "^4.0.0-alpha.26",
    "@vitejs/plugin-legacy": "^5.4.1",
    "terser": "^5.36.0",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "prettier": "^3.3.3",
    "glob": "^11.0.0",
    "fs-extra": "^11.2.0",
    "@types/fs-extra": "^11.0.4",
    "semver": "^7.6.3",
    "@types/semver": "^7.5.8",
    "inquirer": "^10.2.2",
    "@types/inquirer": "^9.0.7",
    "chalk": "^5.3.0",
    "execa": "^9.5.1",
    "crypto": "^1.0.1",
    "@playwright/test": "^1.48.0",
    "playwright": "^1.48.0",
    "start-server-and-test": "^2.0.8",
    "@axe-core/playwright": "^4.9.1"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "clsx": "^2.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.1.38",
  "keywords": [
    "consulting",
    "landing-page",
    "shadcn",
    "tailwindcss",
    "vite",
    "typescript",
    "automation"
  ],
  "author": "DCVS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dcversus/dcversus.wtf.git"
  },
  "bugs": {
    "url": "https://github.com/dcversus/dcversus.wtf/issues"
  },
  "homepage": "https://dcversus.wtf"
}