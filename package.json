{
  "name": "dcversus.wtf",
  "version": "1.0.0",
  "description": "DCVS - Professional consulting landing page with modern design",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "npx serve docs -l 3000",
    "start": "npm run serve",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --fix",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest --coverage",
    "test:e2e": "NODE_ENV=test-playwright VITEST_DISABLE_GLOBALS=true npx playwright test --project=chromium",
    "test:e2e:install": "playwright install",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.0-alpha.26",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-legacy": "^5.4.1",
    "@vitest/ui": "^4.0.16",
    "chalk": "^5.3.0",
    "eslint": "^9.37.0",
    "execa": "^9.5.1",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "husky": "^9.1.7",
    "inquirer": "^10.2.2",
    "jsdom": "^27.3.0",
    "playwright": "^1.51.0",
    "prettier": "^3.3.3",
    "semver": "^7.6.3",
    "serve": "^14.2.5",
    "sharp": "^0.34.5",
    "start-server-and-test": "^2.0.8",
    "tailwindcss": "^4.0.0-alpha.26",
    "terser": "^5.36.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.50.0",
    "vite": "^5.4.10",
    "vite-plugin-live-reload": "^3.0.2",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.1.38",
  "keywords": [
    "consulting",
    "landing-page",
    "shadcn",
    "tailwindcss",
    "vite",
    "typescript",
    "automation"
  ],
  "author": "DCVS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dcversus/dcversus.wtf.git"
  },
  "bugs": {
    "url": "https://github.com/dcversus/dcversus.wtf/issues"
  },
  "homepage": "https://dcversus.wtf"
}
